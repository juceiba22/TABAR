# Copiá este archivo a .env y completá los valores con los de TU proyecto
# de Firebase (Project Settings → General → Your apps → SDK setup and
# configuration → Config). No se commitea (.env está en .gitignore).

# ── Firebase client SDK (se usan en el navegador, deben empezar con VITE_) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin SDK (solo para api/*.js — funciones serverless) ──
# Se generan en Project Settings → Service Accounts → Generate new private key.
# FIREBASE_PRIVATE_KEY va entre comillas, con los \n literales tal cual salen
# del JSON descargado (el código ya los des-escapa).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Resend (envío del email de verificación institucional) ──
# Opcional para levantar el proyecto — solo hace falta si vas a probar el
# flujo de registro por email/password (el login con Google no lo usa).
RESEND_API_KEY=
